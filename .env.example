# Example settings for `docker compose`. Copy it and adjust:
#
#   cp .env.example .env
#   docker compose up -d        # applies changed values; no rebuild needed
#
# `.env` is gitignored, so your real values stay on your machine. Every variable is optional:
# without it, docker-compose.yml uses the default shown in its comment. See docs/security.md.

# UI login. true = everyone must sign in (JWT); false = open access, no login screen (compose default: false).
# With login on, infra/seed/seed.sh and infra/smoke.sh sign in themselves; the k6 scripts in loadtest/ do not.
JWT_ENABLED=true

# Key that signs the login tokens (HS256, at least 32 characters). Default: a development-only key.
# Set your own random value whenever someone else can reach the service, e.g.: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789

# Built-in administrator for the first sign-in on an empty database. Change the password for anything shared.
ADMIN_EMAIL=admin@alerting.local
ADMIN_PASSWORD=admin
